# Vars para tests integration contra Supabase Local CLI.
#
# **Uso:**
#   1. `pnpm exec supabase start` (levanta Docker stack)
#   2. `cp .env.test.example .env.test` (no commitear .env.test)
#   3. `pnpm test:integration`
#
# **Reproducibilidad cambio de compu:**
#   - El stack es 100% efímero (Docker volumes locales). Cambio de compu
#     = `git clone` + `supabase start` + `cp .env.test.example .env.test`.
#   - Datos productivos NUNCA estuvieron en local — viven en Supabase managed cloud.
#
# **Defaults Supabase Local CLI (no cambiar a menos que reconfigures
#   supabase/config.toml):**
NODE_ENV=test

# Postgres local levantado por `supabase start`.
# Puerto 54322 (no 5432) para no colisionar con Postgres host instalado.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API URL + anon/service_role keys son las default del Supabase Local CLI
# (NO son secretos — son las mismas para todo el mundo, public knowledge).
# Si rotás claves en supabase/config.toml, actualizar acá.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Secret config — pueden ser placeholders para integration tests.
JWT_SECRET=integration_test_jwt_secret_min_32_chars_padding_zzz
SECRETS_ENCRYPTION_KEY_V1=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SECRETS_ENCRYPTION_KEY_ACTIVE_VERSION=1

AFIP_ENVIRONMENT=homologacion
MONEY_ROUNDING_MODE=HALF_EVEN
MONEY_ROUNDING_STAGE=PER_LINE
MONEY_CURRENCY=ARS

# Log level alto para tests (no spamear stdout con info/debug).
LOG_LEVEL=error
