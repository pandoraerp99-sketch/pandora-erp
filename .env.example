# ============================================================
# Pandora ERP — Environment Variables
# ============================================================
# Copiar este archivo a `.env.local` y completar valores reales.
# NUNCA commitear .env.local — solo este .env.example.
# Validado en boot por src/lib/env.ts (Zod fail-fast).
# ============================================================

# ---- Runtime ----
NODE_ENV=development

# ---- Database (Supabase Postgres) ----
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ---- Supabase Auth + Storage ----
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- JWT (jose library) ----
JWT_SECRET=cambiar-por-secreto-256-bits-aleatorio-64-hex
JWT_ISSUER=pandora-erp
JWT_AUDIENCE=pandora-erp-clients

# ---- Secrets encryption (versionado — ADR-0019 S5-bis) ----
# Generar con: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY_V1=cambiar-por-hex-64-chars-real
SECRETS_ENCRYPTION_KEY_ACTIVE_VERSION=1

# ---- AFIP ----
AFIP_ENVIRONMENT=homologacion  # homologacion | produccion

# ---- Money policy (ADR-0005) ----
MONEY_ROUNDING_MODE=HALF_EVEN
MONEY_ROUNDING_STAGE=PER_LINE  # PER_LINE | PER_TAX_BRACKET
MONEY_CURRENCY=ARS

# ---- Observability ----
LOG_LEVEL=info  # trace | debug | info | warn | error | fatal
SENTRY_DSN=  # opcional F0, requerido F1+

# ---- Demo lifecycle (ADR-0020) ----
DEMO_TRIAL_DAYS=60
DEMO_READ_ONLY_DAYS=22
DEMO_TOTAL_LIFECYCLE_DAYS=82

# ---- Multi-tenant ----
SYSTEM_TENANT_ID=00000000-0000-0000-0000-000000000000
